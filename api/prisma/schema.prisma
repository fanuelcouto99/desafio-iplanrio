generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Status {
  SOLICITADA
  ACEITA
  EM_ANDAMENTO
  FINALIZADA
}

model Corrida {
  id           String   @id @default(uuid())
  passageiroId String
  motoristaId  String?
  origem       String
  destino      String
  status       Status   @default(SOLICITADA)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([passageiroId, motoristaId, status])
  @@map("corridas")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String
  userId      String
  requestHash String
  corridaId   String
  createdAt   DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, key])
  @@map("idempotency_keys")
}
